### Ran Playwright code
```js
await (async (page) => {
  const records = [];
  for (const label of ['first-submit', 'same-submit-after-success']) {
    const [response] = await Promise.all([
      page.waitForResponse(r => r.url().endsWith('/api/support-requests') && r.request().method() === 'POST'),
      page.getByRole('button', { name: 'Request a listener', exact: true }).click()
    ]);
    const body = await response.json();
    await page.waitForFunction(id => document.body.innerText.includes(id), body.requestId);
    records.push({ label, status: response.status(), response: body, confirmation: await page.getByRole('status').innerText() });
  }
  return { records, storage: await page.evaluate(() => ({ localKeys: Object.keys(localStorage), sessionKeys: Object.keys(sessionStorage), cookieNames: document.cookie.split(';').filter(Boolean).map(x => x.split('=')[0].trim()) })) };
})(page);
```
