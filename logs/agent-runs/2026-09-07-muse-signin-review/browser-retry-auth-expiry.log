await (async (page) => {
  const pattern = '**/api/support-requests';
  let persisted;
  await page.route(pattern, async route => {
    const response = await route.fetch();
    persisted = { status: response.status(), body: await response.json() };
    await route.abort('failed');
  }, { times: 1 });
  await page.getByRole('button', { name: 'Request a listener', exact: true }).click();
  await page.getByText(/Error:.*fetch/i).waitFor();
  const displayedFailure = await page.getByRole('alert').filter({ hasText: 'Error:' }).innerText();
  await page.unroute(pattern);
  const [retried] = await Promise.all([
    page.waitForResponse(r => r.url().endsWith('/api/support-requests') && r.request().method() === 'POST'),
    page.getByRole('button', { name: 'Request a listener', exact: true }).click()
  ]);
  const retryBody = await retried.json();
  await page.waitForFunction(id => document.body.innerText.includes(id), retryBody.requestId);
  await page.route(pattern, route => route.fulfill({ status: 401, contentType: 'application/json', body: JSON.stringify({ error: 'Expired synthetic authentication' }) }), { times: 1 });
  await page.getByRole('button', { name: 'Request a listener', exact: true }).click();
  await page.getByRole('textbox', { name: 'Mobile number', exact: true }).waitFor();
  const expiredAuth = { message: await page.getByRole('alert').filter({ hasText: 'Error:' }).innerText(), submitDisabled: await page.getByRole('button', { name: 'Request a listener', exact: true }).isDisabled(), phoneSignInVisible: await page.getByRole('textbox', { name: 'Mobile number', exact: true }).isVisible() };
  await page.unroute(pattern);
  return { lostResponse: { persisted, displayedFailure, retryStatus: retried.status(), retryBody, sameRequest: persisted.body.requestId === retryBody.requestId, sameKey: persisted.body.idempotencyKey === retryBody.idempotencyKey }, expiredAuth };
})(page);
